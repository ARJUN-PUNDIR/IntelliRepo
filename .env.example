# IntelliRepo API Keys

# GitHub API (For reading issues, reading files, and creating PRs)
GITHUB_TOKEN=your_github_token_here

# LLM Providers (For the AI Brain)
OPENAI_API_KEY=your_openai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# LangSmith (For tracking agent thoughts and debugging LLMs)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="IntelliRepo"

# Neo4j Database Details
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
